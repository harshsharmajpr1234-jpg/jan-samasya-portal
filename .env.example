# ==========================================================================
# Jan Samasya Nivaran Manch — environment example. Copy to `.env` and edit.
# NEVER commit the real .env. All secrets stay server-side.
# ==========================================================================

# --- Database (free tier friendly) -----------------------------------------
# Local dev default is a local PostgreSQL. For a free hosted DB use Neon or
# Supabase (generous free tiers) and paste their connection string here.
DATABASE_URL="postgresql://postgres:postgres@127.0.0.1:5432/app_db"

# --- Sessions & tokens (server only) ----------------------------------------
# REQUIRED. Generate with:  openssl rand -base64 48
JWT_SECRET="replace-me-with-at-least-32-random-characters"

# --- CORS ---------------------------------------------------------------------
# Comma-separated origins allowed to call public APIs cross-origin.
# Leave EMPTY for same-origin-only deployments (recommended & most secure).
# Example: ALLOWED_ORIGINS="https://your-portal.netlify.app"
ALLOWED_ORIGINS=""

# --- Photo storage (zero-cost local disk, private dir) -----------------------
# Files are stored here and served ONLY through the access-controlled
# /api/media/[file] route. To use a free hosted store instead (Cloudinary /
# Supabase Storage free tier), see docs/DEPLOYMENT.md.
UPLOAD_DIR="./data/uploads"
MAX_UPLOAD_MB="4"

# --- Public map defaults (exposed to the browser by design) ------------------
NEXT_PUBLIC_MAP_CENTER_LAT="26.8467"
NEXT_PUBLIC_MAP_CENTER_LNG="80.9462"
NEXT_PUBLIC_MAP_ZOOM="13"

# --- Seed credentials (used ONLY by `npx tsx scripts/seed.ts`) ---------------
# Change these before first run in any real deployment.
SEED_ADMIN_EMAIL="admin@jsnm.local"
SEED_ADMIN_PASSWORD="Admin@JSNM123"
SEED_OFFICER_PASSWORD="Officer@JSNM123"
